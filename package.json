{
  "name": "invista-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:python": "pip install -r requirements.txt",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && node app.js",
    "deploy": "npm run install:backend && npm run install:frontend && npm run build:frontend && npm run start"
  }
}
